FROM python:3.11-slim

WORKDIR /app

COPY requirements-sparkov-serving.txt .
RUN pip install --no-cache-dir -r requirements-sparkov-serving.txt

COPY src/ src/
COPY models/artifacts/sparkov_production_pipeline.joblib models/artifacts/sparkov_production_pipeline.joblib
COPY models/artifacts/sparkov_production_metadata.json models/artifacts/sparkov_production_metadata.json

EXPOSE 8001
CMD ["uvicorn", "src.serving.sparkov_app:app", "--host", "0.0.0.0", "--port", "8001"]
